FROM node:24-slim AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY web/package.json web/package.json
COPY shared shared
COPY keeper keeper
RUN pnpm install --frozen-lockfile --filter keeper...
RUN E=$(ls -d node_modules/.pnpm/esbuild@*/node_modules/esbuild/bin/esbuild | head -1) \
 && "$E" keeper/src/main.ts --bundle --platform=node --format=esm --target=node24 \
    --banner:js="import {createRequire as __cr} from 'node:module'; const require = __cr(import.meta.url);" \
    --outfile=/out/keeper.mjs --log-level=warning

FROM node:24-slim
WORKDIR /app
COPY --from=build /out/keeper.mjs ./keeper/keeper.mjs
COPY deployments/near-testnet.json ./deployments/near-testnet.json
ENV NODE_ENV=production NODE_OPTIONS=--max-old-space-size=256 NEAR_NETWORK=testnet
USER node
EXPOSE 8787
CMD ["node", "keeper/keeper.mjs"]
