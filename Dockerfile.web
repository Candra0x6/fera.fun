FROM node:24-slim
RUN corepack enable
WORKDIR /app
COPY . .
ARG VITE_CHAIN_ID
ARG VITE_RPC_HTTP_URL
ARG VITE_RPC_WS_URL
ARG VITE_ARENA_ADDRESS
ARG VITE_DEPLOY_BLOCK
ARG VITE_ROUND_ID
ARG VITE_KEEPER_URL
ARG VITE_DEMO_TOKEN
ENV VITE_CHAIN_ID=$VITE_CHAIN_ID VITE_RPC_HTTP_URL=$VITE_RPC_HTTP_URL VITE_RPC_WS_URL=$VITE_RPC_WS_URL VITE_ARENA_ADDRESS=$VITE_ARENA_ADDRESS VITE_DEPLOY_BLOCK=$VITE_DEPLOY_BLOCK VITE_ROUND_ID=$VITE_ROUND_ID VITE_KEEPER_URL=$VITE_KEEPER_URL VITE_DEMO_TOKEN=$VITE_DEMO_TOKEN
RUN pnpm install --frozen-lockfile --filter web...
RUN pnpm --filter web exec vite build
CMD ["sh", "-c", "pnpm --filter web exec vite preview --host 0.0.0.0 --port ${PORT:-4173}"]
